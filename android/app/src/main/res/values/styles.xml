<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- The theme BridgeActivity switches to once the WebView is in place.
         windowBackground is the app's own launch colour rather than the
         AppCompat default: it is what shows for the instant between the
         splash handing over and the web layer's first paint, and white there
         reads as a flash against every screen in the app. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/fjallkompisLaunch</item>
    </style>

    <!-- Launch theme. Two eras, one look:
           Android 12+ (API 31+) composes the splash itself from the
           windowSplashScreen* attributes below — the platform owns the
           timing, the icon reveal and the handoff animation.
           Android 7-11 gets the same colour + mark as a plain window
           background, via @drawable/fjallkompis_splash.
         The icon is the launcher foreground, so the mark on the splash and
         the mark on the home screen are the same drawable at the same
         inset — deliberately conservative sizing, since the platform masks
         this icon again. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fjallkompisLaunch</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:background">@drawable/fjallkompis_splash</item>
        <item name="android:windowBackground">@drawable/fjallkompis_splash</item>
    </style>
</resources>
