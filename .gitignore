node_modules
dist
dist-ssr
*.local

# Real environment files are never committed (API keys). `*.local` above
# already covers .env.local; these cover every other .env variant. The
# tracked template with empty placeholders is .env.example.
.env
.env.*
!.env.example
.DS_Store
.vscode/*
!.vscode/extensions.json
dev-dist
.claude/
*.tsbuildinfo

# Generated Google Play capture output and local tooling caches.
artifacts/store-capture/
artifacts/store-feature-graphics/
.npm-cache/

# Satellite archive: canonical copy is the satellite-data-vN GitHub Release
# asset, injected into the Pages build by deploy.yml — never committed.
public/maps/kungsleden-satellite.pmtiles

# Terrain relief archives: same model — canonical copies live on the
# terrain-data-vN GitHub Release, injected by deploy.yml, never committed.
# Build locally with scripts/build-terrain-map.sh.
public/maps/kungsleden-terrain.pmtiles
public/maps/kungsleden-contours.pmtiles
# Written by every build (and attached to the release); describes local
# binaries that are themselves not committed.
public/maps/kungsleden-terrain-provenance.json

# Android wrapper spike (Capacitor). The android/ project IS committed; its own
# android/.gitignore (Google's template, shipped by Capacitor) already excludes
# build outputs, .gradle/, local.properties, the copied web assets and the
# generated Capacitor config. These are the gaps that template leaves
# commented out or scopes to the project directory only — signing material
# above all, which must never reach this repository from anywhere in the tree.
*.apk
*.aab
*.keystore
*.jks
local.properties
.idea/
*.iml

# Play release signing material. The upload keystore lives ONLY in Omar's
# offline backup and in GitHub Actions secrets — never in the repository, and
# never in a build artifact. These patterns are deliberately broad: a keystore
# committed once is compromised forever, because git history keeps it.
*.jks
*.p12
*.pepk
upload-keystore*
keystore.properties
signing.properties
*.keystore.base64
*.b64
